{
  "name": "@yjh1102/qrcode-gen",
  "version": "0.1.0",
  "description": "一个功能完善的二维码生成工具库,支持颜色定制、尺寸调整、Logo嵌入和多格式输出",
  "main": "dist/qrcode-gen.js",
  "module": "dist/qrcode-gen.esm.js",
  "types": "src/types/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"examples/**/*.html\"",
    "benchmark": "node tests/benchmark.js"
  },
  "keywords": [
    "qrcode",
    "qr-code",
    "generator",
    "canvas",
    "svg",
    "logo",
    "二维码"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "benchmark": "^2.1.4",
    "rollup": "^4.12.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
